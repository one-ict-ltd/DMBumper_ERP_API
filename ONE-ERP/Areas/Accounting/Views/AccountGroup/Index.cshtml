@{
    ViewData["Title"] = "Account Group";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card">
    <div class="card-body">
        <h5 class="card-title" style="color: black">Account Group</h5>
        <hr>
        <form id="fromGroup" method="post" data-parsley-validate="parsley">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="row">
                <input type="hidden" id="accountGroupId" name="accountGroupId" value=0>
                <div class="col-sm-6">
                    <div class="form-group row">
                        <label for="groupNatureId" class="col-sm-4 col-form-label">Nature of Group <span style="color:red;">*</span></label>
                        <div class="col-sm-8">
                            <select name="groupNatureId" id="groupNatureId" class="form-control" data-parsley-required="true">
                            </select>
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="isActive" class="col-sm-4 col-form-label">Status</label>
                        <div class="col-sm-8">
                            <select name="isActive" id="isActive" class="form-control">
                                <option value="">Select</option>
                                <option value="1">Active</option>
                                <option value="0">Inactive</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group row">
                        <label for="groupCode" class="col-sm-4 col-form-label">Group Code <span style="color:red;">*</span></label>
                        <div class="col-sm-8">
                            <input type="text" class="form-control" id="groupCode" name="groupCode" data-parsley-required="true">
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="groupName" class="col-sm-4 col-form-label">Group Name <span style="color:red;">*</span></label>
                        <div class="col-sm-8">
                            <input type="text" class="form-control" id="groupName" name="groupName" data-parsley-required="true">
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="groupName" class="col-sm-4 col-form-label"></label>
                        <div class="col-sm-8">
                            <button type="button" id="btnSave" onclick="SaveAccountGroup()" class="btn btn-success btn-sm" style="width:80px;">Save</button>
                        </div>
                    </div>
                </div>
            </div>
            <hr>
            @*<button type="submit" value="Submit" class="btn btn-success btn-sm" style="float:right; margin-top:5px;">Save</button>*@
            
        </form>
    </div>
</div>
<br />
<hr />
<div class="row clearfix">
    <div class="col-12">
        <div class="card mb-4">
            <!-- Card Header - Dropdown -->
            <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                <h6 class="m-0 font-weight-bold text-primary">Account Group List</h6>
            </div>
            <!-- Card Body -->
            <div class="card-body">
                <table class="table table-striped table-bordered" id="groupTable">
                    <thead>
                        <tr>
                            <th>Sl#</th>
                            <th>Group Name</th>
                            <th>Group Code</th>
                            <th>Nature Name</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script>
        $(document).ready(function () {

            $('#groupTable').DataTable();
            Common.Ajax('GET', '/api/GroupNature/GetGroupNature/', [], 'json', GetGroupNature);
            Common.Ajax('GET', '/api/AccountGroup/GetAccountGroupList/', [], 'json', ajaxGetAccountGroupList);

            $("#groupNatureId").change(function () {
                var natureId = $(this).val() ? $(this).val() : '';
                AccountGroupCodeByNature(natureId);               
            });

        });

        function AccountGroupCodeByNature(natureId) {
            
            if (natureId == '') {
                swal("Please select group nature");
                return false;
            }
            $.ajax({
                url: "/Accounting/AccountGroup/GetAccountGroupCodeByNature?natureId=" + natureId ,
                type: "GET",
                dataType: "json",
                success: function (records) {
                    $("#groupCode").val(records);
                },
                failure: function () {
                    $.alert.open("error", "Failed!");
                }
            });
        }

        function GetGroupNature(response) {
            $('#groupNatureId').empty();
            var options = '<option value="0">Select</option>';
            $.each(response, function (i, item) {
                options += '<option value="' + item.groupNatureId + '">' + item.natureName + '</option>';
            });
            $('#groupNatureId').append(options);
        }

        function ajaxGetAccountGroupList(response) {
            if (response == null) {
                return false;
            }
            $("#groupTable").DataTable().destroy();
            var table = $("#groupTable tbody");
            table.empty();
            var index = 0;
            for (var i = 0; i < response.length; i++) {
                index = i + 1;
                table.append('<tr><td>' + index + '</td>'
                    + '<td>' + response[i].groupName + '</td>'
                    + '<td>' + response[i].groupCode + '</td>'
                    + '<td>' + response[i].natureName + '</td>'
                    + '<td>' + response[i].status + '</td>'
                    + '<td><a class="btn btn-success" title="Edit" onclick="Edit(' + index + ')" ><i class="fa fa-edit"></i></a>&nbsp;<a href="javascript:void(0)"style="background-color:red;border-color:red" data-toggle="tooltip" title="Delete" class="btn btn-danger btn-xs" onclick="Delete(' + index + ')"><i class="fa fa-trash"></i></a></td>'
                    + '</tr >');
            }
            $("#groupTable").DataTable({
                stateSave: false,
                dom: "<'row'<'col-sm-12 col-md-2'l><'col-sm-12 col-md-3'B><'col-sm-12 col-md-7'f>>" +
                    "<'row'<'col-sm-12't>>" +
                    "<'row'<'col-sm-12 col-md-6'i><'col-sm-12 col-md-6'pr>>",
                buttons: [
                    {
                        extend: 'excelHtml5',
                        text: '<i class="fa fa-file-excel"></i> Excel',
                        titleAttr: 'Excel',
                        exportOptions: {
                            columns: [0, 1, 2, 3,4]
                        },
                        title: "Account Group",
                        class: 'btn btn-info'
                    },
                    {
                        extend: 'csvHtml5',
                        text: '<i class="fa fa-file-excel"></i> CSV',
                        titleAttr: 'CSV',
                        exportOptions: {
                            columns: [0, 1, 2, 3,4]
                        },
                        title: "Account Group",
                    }
                ]
            });
        }


        function Edit(accountGroupId, natureId, parentGroupId, groupCode, groupName) {
            $('#accountGroupId').val(accountGroupId);
            $('#natureId').val(natureId);
            $('#parentGroupId').val(parentGroupId);
            $('#groupCode').val(groupCode);
            $('#groupName').val(groupName);
        }

         function DeleteMaster(Id) {
            swal({
                title: 'Are you sure?', text: 'Do you want to delete this record!', type: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Yes, delete it!'
            }).then(function () {

                $.ajax({
                    url: '@Url.Action("DeleteaccountGroupById", "VoucherSetting")',
                    data: { Id: Id },
                    type: 'POST',
                })
                    .done(function () {
                        swal('', 'Deleted Successfully!', 'success');
                        window.location.href = "/Accounting/VoucherSetting/AccountGroup";
                    })
                    .fail(function () {
                        swal('Cancelled', 'It will not be deleted. Please try again later !!!', 'error');
                    });
            });
        }

        function SaveAccountGroup() {
            let groupNatureId = $('#groupNatureId').val();
            let isActive = $('#isActive').val();
            let groupCode = $('#groupCode').val();
            let groupName = $('#groupName').val();
            if (groupNatureId == 0) {
                swal("Please select group nature");
                return false;
            }
            else if (isActive == "") {
                swal("Please select status");
                return false;
            }
            else if (groupCode == "") {
                swal("Please insert group code");
                return false;
            }
            else if (groupName == "") {
                swal("Please insert group name");
                return false;
            }
            var form = $("#fromGroup");
                $.ajax({
                    url: '@Url.Action("setaccountGroup", "AccountGroup")',
                    data: form.serialize(),
                    type: 'POST',
                    success: function (records) {
                        swal({
                            title: '', text: 'Saved Successfully!', type: 'success', showCancelButton: false, confirmButtonColor: '#3085d6', confirmButtonText: 'Ok!',
                        }).then(function () {                            
                            $('#groupNatureId').val('');
                            $('#isActive').val('');
                            $('#groupCode').val('');
                            $('#groupName').val('');
                        });
                    }
                });
        }

    </script>
}


